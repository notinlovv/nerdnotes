/* NerdNotes - Dark Theme (Refined & Modern) */
* {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Ubuntu, "Helvetica Neue", sans-serif;
    font-size: 13px;
    color: #d4d4d8;
    outline: none;
}

QMainWindow, QDialog, QMessageBox, QInputDialog, QFileDialog {
    background-color: #121214;
    color: #f4f4f5;
}

QWidget {
    background-color: transparent;
    color: #d4d4d8;
}

/* --- Splitter de 1px sólido en tono neutro sutil --- */
QSplitter::handle {
    background-color: #26262a;
    width: 1px;
}
QSplitter::handle:hover {
    background-color: #3f3f46;
}

/* --- Escala de Elevación de Tres Niveles de Color --- */
#widget_sidebar {
    background-color: #121214;
    border-right: 1px solid #26262a;
}

#widget_lista {
    background-color: #161618;
    border-right: 1px solid #26262a;
}

#widget_editor {
    background-color: #1a1a1e;
}

/* --- Franja superior uniforme de 44px (Horizonte compartido) --- */
#header_panel {
    border-bottom: 1px solid #26262a;
    min-height: 43px;
    max-height: 43px;
    background-color: transparent;
}

/* --- Listas y Model Views --- */
QListView, QListWidget, QTreeView {
    background-color: transparent;
    border: none;
    padding: 2px;
}

QListView::item, QListWidget::item {
    border-radius: 6px;
    margin: 2px 4px;
    padding: 6px 10px;
    border: none;
}

QListView::item:hover, QListWidget::item:hover {
    background-color: #1e1e22;
}

QListView::item:selected, QListWidget::item:selected {
    background-color: #223045;
    color: #f4f4f5;
}

/* --- Inputs (QLineEdit) y Desplegables (QComboBox) homogeneizados a 32px --- */
QLineEdit {
    background-color: #222226;
    color: #f4f4f5;
    border: 1px solid #27272a;
    border-radius: 6px;
    padding: 0px 8px;
    min-height: 32px;
    max-height: 32px;
    font-size: 13px;
    selection-background-color: #2563eb;
}

QLineEdit:focus {
    border: 1px solid #3b82f6;
    background-color: #26262b;
}

/* Campo de título grande H1 sin bordes para el editor */
QLineEdit#editor_titulo {
    background-color: transparent;
    border: none;
    color: #f4f4f5;
    font-size: 22px;
    font-weight: bold;
    padding: 0px;
    min-height: 36px;
    max-height: 36px;
    selection-background-color: #2563eb;
}

QLineEdit#editor_titulo:focus {
    background-color: transparent;
    border: none;
}

QLineEdit#editor_titulo:read-only {
    background-color: transparent;
    color: #f4f4f5;
}

QLineEdit#editor_titulo:disabled {
    background-color: transparent;
    color: #71717a;
}

QComboBox {
    background-color: #222226;
    color: #f4f4f5;
    border: 1px solid #27272a;
    border-radius: 6px;
    padding: 0px 8px;
    min-height: 32px;
    max-height: 32px;
}

QComboBox:hover {
    border-color: #3f3f46;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px;
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #222226;
    color: #f4f4f5;
    border: 1px solid #27272a;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #223045;
}

/* --- Editor de Texto --- */
QTextEdit {
    background-color: transparent;
    color: #d4d4d8;
    border: none;
    font-size: 14px;
    selection-background-color: #264f78;
}

QTextEdit:disabled {
    background-color: transparent;
    color: #71717a;
}

QTextEdit:read-only {
    background-color: transparent;
    color: #d4d4d8;
}

/* --- Botones --- */
QPushButton {
    background-color: #27272a;
    color: #f4f4f5;
    border: 1px solid #3f3f46;
    border-radius: 6px;
    padding: 6px 12px;
    min-height: 32px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #3f3f46;
    border-color: #52525b;
}

QPushButton:pressed {
    background-color: #1e1e22;
}

QPushButton:checked {
    background-color: #223045;
    color: #ffffff;
    border-color: #3b82f6;
}

/* Botones de icono compactos (28px - 32px) */
QPushButton#btn_icon {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px;
    min-width: 28px;
    max-width: 32px;
    min-height: 28px;
    max-height: 32px;
}

QPushButton#btn_icon:hover {
    background-color: #27272a;
    border-color: #3f3f46;
}

QPushButton#btn_icon:pressed {
    background-color: #202024;
}

QPushButton#btn_icon:checked {
    background-color: #223045;
    border-color: #3b82f6;
}

/* --- Menús --- */
QMenu {
    background-color: #1e1e22;
    color: #f4f4f5;
    border: 1px solid #27272a;
    border-radius: 8px;
    padding: 5px;
}

QMenu::item {
    border-radius: 4px;
    padding: 6px 24px 6px 12px;
}

QMenu::item:selected {
    background-color: #223045;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #27272a;
    margin: 4px 8px;
}

/* --- Scrollbars finas y elegantes --- */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 7px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #3f3f46;
    border-radius: 3px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #52525b;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    height: 0px;
    background: transparent;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 7px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #3f3f46;
    border-radius: 3px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #52525b;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    width: 0px;
    background: transparent;
}

/* --- Barra de estado --- */
QStatusBar {
    background-color: #121214;
    color: #71717a;
    border-top: 1px solid #26262a;
    min-height: 26px;
}

/* --- Etiquetas y Títulos Específicos --- */
#lbl_app_logo {
    color: #3b82f6;
    font-weight: bold;
    font-size: 15px;
}

#lbl_seccion {
    color: #71717a;
    font-size: 11px;
    font-weight: bold;
    margin-top: 8px;
    margin-left: 4px;
}

#lbl_titulo_actual {
    color: #f4f4f5;
    font-weight: bold;
    font-size: 15px;
}

#lbl_metadata_nota {
    color: #71717a;
    font-size: 11px;
    padding: 2px 0px 6px 0px;
}

#lbl_contador {
    color: #71717a;
    font-size: 11px;
    padding-right: 12px;
}

#lbl_estado_guardado {
    color: #71717a;
    font-size: 11px;
    padding-right: 8px;
}

#btn_deshacer {
    background-color: #2563eb;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: bold;
    min-height: 22px;
}

#btn_deshacer:hover {
    background-color: #3b82f6;
}

/* --- Tooltips --- */
QToolTip {
    background-color: #27272a;
    color: #f4f4f5;
    border: 1px solid #3f3f46;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
}

/* --- Barra de Formato Markdown en Editor --- */
#toolbar_formato {
    background-color: transparent;
    margin-top: 2px;
    margin-bottom: 4px;
}

#toolbar_formato QPushButton {
    background-color: transparent;
    color: #a1a1aa;
    border: none;
    border-radius: 4px;
    padding: 0px 8px;
    height: 26px;
    min-height: 26px;
    max-height: 26px;
    font-size: 12px;
    font-weight: 500;
}

#toolbar_formato QPushButton:hover {
    background-color: #2a2a2e;
    color: #f4f4f5;
}

#toolbar_formato QPushButton:pressed {
    background-color: #323238;
}

#toolbar_formato QPushButton:disabled {
    color: #52525b;
}

#toolbar_formato QFrame#toolbar_separador {
    background-color: #27272a;
    width: 1px;
    max-width: 1px;
    margin: 3px 4px;
    border: none;
}

/* --- Botón rápido de etiquetas en metadatos --- */
QPushButton#btn_tag_rapido {
    height: 22px;
    min-height: 22px;
    max-height: 22px;
    padding: 2px 8px;
    border: 1px solid #27272a;
    border-radius: 11px;
    background-color: #1e1e22;
    color: #a1a1aa;
    font-size: 11px;
}

QPushButton#btn_tag_rapido:hover {
    background-color: #27272a;
    color: #f4f4f5;
    border-color: #3b82f6;
}

QPushButton#btn_tag_rapido:disabled {
    color: #52525b;
    border-color: transparent;
    background-color: transparent;
}
