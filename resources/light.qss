/* NerdNotes - Light Theme (Refined & Modern) */
* {
    font-family: 'Inter', 'Noto Sans', 'Segoe UI', 'Ubuntu', sans-serif;
    font-size: 13px;
    color: #1f2328;
    outline: none;
}

QMainWindow, QDialog, QMessageBox, QInputDialog, QFileDialog {
    background-color: #ebeef2;
    color: #1f2328;
}

QWidget {
    background-color: transparent;
    color: #1f2328;
}

/* --- Splitter de 1px en tono neutro sutil --- */
QSplitter::handle {
    background-color: #e4e4e7;
    width: 1px;
}
QSplitter::handle:hover {
    background-color: #cbd5e1;
}

/* --- Jerarquía Cromática de Columnas --- */
#widget_sidebar {
    background-color: #ebeef2;
    border-right: 1px solid #e4e4e7;
}

#widget_lista {
    background-color: #f4f6f8;
    border-right: 1px solid #e4e4e7;
}

#widget_editor {
    background-color: #ffffff;
}

/* --- Franja superior uniforme de 44px (Horizonte compartido) --- */
#header_panel {
    border-bottom: 1px solid #e4e4e7;
    min-height: 43px;
    max-height: 43px;
    background-color: transparent;
}

/* --- Listas y Model Views --- */
QListView, QListWidget, QTreeView {
    background-color: transparent;
    border: none;
    padding: 2px;
}

QListView::item, QListWidget::item {
    border-radius: 6px;
    margin: 2px 4px;
    padding: 6px 10px;
    border: none;
}

QListView::item:hover, QListWidget::item:hover {
    background-color: #f4f4f5;
}

QListView::item:selected, QListWidget::item:selected {
    background-color: #e0edff;
    color: #0043ce;
}

/* --- Inputs (QLineEdit) y Desplegables (QComboBox) homogeneizados a 32px --- */
QLineEdit {
    background-color: #ffffff;
    color: #1f2328;
    border: 1px solid #e4e4e7;
    border-radius: 6px;
    padding: 0px 8px;
    min-height: 32px;
    max-height: 32px;
    font-size: 13px;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

QLineEdit:focus {
    border: 1px solid #2563eb;
    background-color: #ffffff;
}

/* Campo de título grande H1 sin bordes para el editor (22px semi-bold) */
QLineEdit#editor_titulo {
    background-color: transparent;
    border: none;
    color: #18181b;
    font-size: 22px;
    font-weight: 600;
    padding: 0px;
    min-height: 36px;
    max-height: 36px;
    selection-background-color: #2563eb;
}

QLineEdit#editor_titulo:focus {
    background-color: transparent;
    border: none;
}

QLineEdit#editor_titulo:read-only {
    background-color: transparent;
    color: #18181b;
}

QLineEdit#editor_titulo:disabled {
    background-color: transparent;
    color: #8c959f;
}

QComboBox {
    background-color: #ffffff;
    color: #1f2328;
    border: 1px solid #e4e4e7;
    border-radius: 6px;
    padding: 0px 8px;
    min-height: 32px;
    max-height: 32px;
}

QComboBox:hover {
    border-color: #cbd5e1;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px;
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1f2328;
    border: 1px solid #e4e4e7;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #e0edff;
}

/* --- Editor de Texto --- */
QTextEdit {
    background-color: transparent;
    color: #1f2328;
    border: none;
    font-size: 15px;
    selection-background-color: #b3d7ff;
}

QTextEdit:disabled {
    background-color: transparent;
    color: #8c959f;
}

QTextEdit:read-only {
    background-color: transparent;
    color: #1f2328;
}

/* --- Botones --- */
QPushButton {
    background-color: #ffffff;
    color: #1f2328;
    border: 1px solid #e4e4e7;
    border-radius: 6px;
    padding: 6px 12px;
    min-height: 32px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #f4f4f5;
    border-color: #cbd5e1;
}

QPushButton:pressed {
    background-color: #e4e4e7;
}

QPushButton:checked {
    background-color: #e0edff;
    color: #0043ce;
    border-color: #2563eb;
}

/* Botones de icono compactos (28px - 32px) */
QPushButton#btn_icon {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px;
    min-width: 28px;
    max-width: 32px;
    min-height: 28px;
    max-height: 32px;
}

QPushButton#btn_icon:hover {
    background-color: #f4f4f5;
    border-color: #e4e4e7;
}

QPushButton#btn_icon:pressed {
    background-color: #e4e4e7;
}

QPushButton#btn_icon:checked {
    background-color: #e0edff;
    border-color: #2563eb;
}

/* --- Menús --- */
QMenu {
    background-color: #ffffff;
    color: #1f2328;
    border: 1px solid #e4e4e7;
    border-radius: 8px;
    padding: 5px;
}

QMenu::item {
    border-radius: 4px;
    padding: 6px 24px 6px 12px;
}

QMenu::item:selected {
    background-color: #e0edff;
    color: #0043ce;
}

QMenu::separator {
    height: 1px;
    background-color: #e4e4e7;
    margin: 4px 8px;
}

/* --- Scrollbars finas y elegantes --- */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 7px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #cbd5e1;
    border-radius: 3px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #94a3b8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    height: 0px;
    background: transparent;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 7px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #cbd5e1;
    border-radius: 3px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #94a3b8;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    width: 0px;
    background: transparent;
}

/* --- Barra de estado --- */
QStatusBar {
    background-color: #ebeef2;
    color: #71717a;
    border-top: 1px solid #e4e4e7;
    min-height: 26px;
}

/* --- Etiquetas y Títulos Específicos --- */
#lbl_app_logo {
    color: #2563eb;
    font-weight: bold;
    font-size: 15px;
}

#lbl_seccion {
    color: #71717a;
    font-size: 11px;
    font-weight: bold;
    margin-top: 8px;
    margin-left: 4px;
}

#lbl_titulo_actual {
    color: #18181b;
    font-weight: bold;
    font-size: 15px;
}

#lbl_metadata_nota {
    color: #71717a;
    font-size: 12px;
    padding: 2px 0px 6px 0px;
}

#lbl_contador {
    color: #71717a;
    font-size: 12px;
    padding-right: 12px;
}

#lbl_estado_guardado {
    color: #71717a;
    font-size: 12px;
    padding-right: 8px;
}

#btn_deshacer {
    background-color: #2563eb;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: bold;
    min-height: 22px;
}

#btn_deshacer:hover {
    background-color: #1d4ed8;
}

/* --- Tooltips --- */
QToolTip {
    background-color: #ffffff;
    color: #1f2328;
    border: 1px solid #e4e4e7;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
}

/* --- Barra de Formato Markdown en Editor --- */
#toolbar_formato {
    background-color: transparent;
    margin-top: 4px;
    margin-bottom: 6px;
}

#toolbar_formato QPushButton {
    background-color: transparent;
    color: #71717a;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 0px 8px;
    min-width: 28px;
    height: 28px;
    min-height: 28px;
    max-height: 28px;
    font-size: 12px;
    font-weight: 500;
}

#toolbar_formato QPushButton:hover {
    background-color: #e4e4e7;
    color: #18181b;
    border-color: #cbd5e1;
}

#toolbar_formato QPushButton:pressed {
    background-color: #d4d4d8;
    color: #09090b;
}

#toolbar_formato QPushButton:disabled {
    color: #a1a1aa;
}

#toolbar_formato QFrame#toolbar_separador {
    background-color: #e4e4e7;
    width: 1px;
    max-width: 1px;
    height: 14px;
    min-height: 14px;
    max-height: 14px;
    margin: 7px 4px;
    border: none;
}

/* --- Botón rápido de etiquetas en metadatos --- */
QPushButton#btn_tag_rapido {
    height: 22px;
    min-height: 22px;
    max-height: 22px;
    padding: 2px 8px;
    border: 1px solid #e4e4e7;
    border-radius: 11px;
    background-color: #f4f4f5;
    color: #71717a;
    font-size: 11px;
}

QPushButton#btn_tag_rapido:hover {
    background-color: #e4e4e7;
    color: #18181b;
    border-color: #3b82f6;
}

QPushButton#btn_tag_rapido:disabled {
    color: #a1a1aa;
    border-color: transparent;
    background-color: transparent;
}
